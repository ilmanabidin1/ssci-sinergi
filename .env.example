# Server-only secrets
DATABASE_URL=mysql://user:password@host:3306/database
JWT_SECRET=replace-with-a-long-random-secret
OPENROUTER_API_KEY=replace-with-openrouter-api-key
PILOT_ADMIN_EMAIL=admin@example.com
PILOT_ADMIN_PASSWORD=replace-with-a-strong-random-password

# Optional external OAuth authentication
VITE_APP_ID=replace-with-app-id
VITE_OAUTH_PORTAL_URL=https://example.com
OAUTH_SERVER_URL=https://example.com
OWNER_OPEN_ID=replace-with-owner-open-id
