# Server-only secrets
DATABASE_URL=mysql://user:password@host:3306/database
JWT_SECRET=replace-with-a-long-random-secret
# Amanah AI: server model yang kompatibel dengan API OpenAI (lihat docs/AMANAH_AI.md)
AI_BASE_URL=https://alamat-server-model/v1
AI_API_KEY=replace-with-model-server-key
AI_MODEL=Qwen/Qwen3.8-27B-FP8
PILOT_ADMIN_EMAIL=admin@example.com
PILOT_ADMIN_PASSWORD=replace-with-a-strong-random-password

# Optional external OAuth authentication
VITE_APP_ID=replace-with-app-id
VITE_OAUTH_PORTAL_URL=https://example.com
OAUTH_SERVER_URL=https://example.com
OWNER_OPEN_ID=replace-with-owner-open-id
