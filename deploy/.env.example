# Salin menjadi /opt/ssci/.env di server, isi, lalu: chmod 600 .env
# Jangan pernah menaruh berkas .env yang sudah diisi di repositori.

# Domain yang diarahkan ke IP server (tanpa https://)
SSCI_DOMAIN=ssci.contoh.id

# Password database. Pakai huruf dan angka saja (misalnya hasil: openssl rand -hex 24),
# karena MYSQL_PASSWORD ikut menjadi bagian dari alamat koneksi.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Rahasia aplikasi
JWT_SECRET=
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_PASSWORD=
SUPERADMIN_EMAILS=
ENFORCE_TWO_FACTOR=true

# Fitur AI. Kosongkan agar tidak ada data yang dikirim ke penyedia AI di luar negeri;
# semua fitur AI lalu memakai cadangan berbasis aturan.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Backup (dipakai deploy/backup.sh)
# Kata sandi enkripsi berkas backup. Simpan salinannya di luar server: tanpa ini backup tidak bisa dibuka.
BACKUP_PASSPHRASE=
# Object storage kompatibel S3 di pusat data kedua (misalnya NEO Object Storage)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Lama simpan (hari)
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_KEEP_REMOTE_DAYS=30
